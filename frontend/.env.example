# Backend Port (default: 8001 to prevent WinError 10013 on Windows reserved port 8000)
BACKEND_PORT=8001

# Optional full backend URL override for Vite proxy
# BACKEND_URL=http://127.0.0.1:8001

# Optional direct API Base URL (if bypassing Vite proxy)
# VITE_API_URL=http://127.0.0.1:8001/api

# Frontend dev server port (default: 3000)
# PORT=3000
